# Copy to .env and fill in. .env is git-ignored.
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_URL=
# Optional locally (a dev default exists). Required on Render: at least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Optional: address search (geoapify.com, free tier). Without it the geo endpoints answer 503.
GEOAPIFY_API_KEY=
