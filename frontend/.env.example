# API base path. The browser calls our own origin; Vite (dev) and Vercel (prod) forward /api to the backend.
VITE_API_BASE=/api/v1

# Map tiles. Set a MapTiler key (restricted to your domains) for production.
# Without a key the app falls back to Stadia "alidade_smooth", which works keyless on localhost only.
VITE_MAP_TILE_KEY=
